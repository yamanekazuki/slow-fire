rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // みんなのBBQ記録（投稿）— 全員閲覧、認証済み(匿名含む)は投稿可、本人のみ削除
    match /cooks/{id} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.dishName is string
                    && request.resource.data.dishName.size() > 0
                    && request.resource.data.dishName.size() <= 80
                    && request.resource.data.photos.size() <= 8;
      // 更新は reactionCount（🔥リアクション）の変更のみ許可
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCount']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 買い物チェックの「回」（2026-08-28）— URLを知っている運営・仲間が同じチェック状態を共有する。
    // 機微情報なし（料理名と買った/未購入のみ）。匿名認証で作成・更新可、削除不可
    match /shoplists/{listId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 60;
      allow update: if request.auth != null
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 60;
      allow delete: if false;
    }

    // 月1BBQアルバム（2026-08-24）— albumId（推測不可ID）を知っている人だけ到達できる。
    // アルバム台帳: 単体getのみ許可・一覧列挙は不可（URLが実質の鍵）。作成はFunctionsのみ
    match /albums/{albumId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;

      // 写真: アルバムIDを知っていれば閲覧・投稿可（匿名認証必須）
      match /photos/{photoId} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.resource.data.keys().hasOnly(['path', 'url', 'by', 'createdAt', 'contentType'])
                      && request.resource.data.path is string
                      && request.resource.data.path.size() <= 300
                      && request.resource.data.url is string
                      && request.resource.data.url.size() <= 1000
                      && request.resource.data.by is string
                      && request.resource.data.by.size() <= 30;
        allow update, delete: if false;
      }
    }

    // ユーザープロファイル — 本人のみ書込、閲覧は全員（表示名・アイコン表示用）
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // 月1BBQ申込（2026-07-25）— 誰でも送信可・読み取りは運営のみ(Functions/SA経由)
    match /event_regs/{id} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('.*@.*[.].*')
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.eventId is string
                    && request.resource.data.eventId.size() <= 20
                    && request.resource.data.party is int
                    && request.resource.data.party >= 1
                    && request.resource.data.party <= 4
                    && request.resource.data.note.size() <= 1000;
      allow read, update, delete: if false;
    }

    // バーベキュー講座申込（2026-07-31）— 誰でも送信可・読み取りは運営のみ
    match /lecture_regs/{id} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('.*@.*[.].*')
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.eventId is string
                    && request.resource.data.eventId.size() <= 20
                    && request.resource.data.party is int
                    && request.resource.data.party >= 1
                    && request.resource.data.party <= 4
                    && request.resource.data.note.size() <= 1000;
      allow read, update, delete: if false;
    }

    // コミュニティ入会（2026-07-25）— 誰でも送信可・読み取りは運営のみ
    match /members/{id} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('.*@.*[.].*')
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.note.size() <= 1000;
      allow read, update, delete: if false;
    }

    // 月1BBQ残枠カウンタ — 全員閲覧可（人数表示用）・書込はFunctionsのみ
    match /event_stats/{id} {
      allow read: if true;
      allow write: if false;
    }

    // お問い合わせ（2026-07-05 監査対応）— 誰でも送信可・読み取りは管理者のみ(コンソール/SA)
    match /contact_messages/{id} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if false;
    }

    // LINE修正受付キュー（2026-07-25）— クライアントからは一切触らせない
    // 書込=lineWebhook(Functions) / 読み書き=ローカル処理ループ(SA/ADC経由)
    match /site_requests/{id} {
      allow read, write: if false;
    }

    // LINEグループID等の運用ステート — Functions専用
    match /line_state/{id} {
      allow read, write: if false;
    }

  }
}
